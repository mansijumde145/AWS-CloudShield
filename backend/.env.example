# ==============================================================================
# AWS CloudShield - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the backend/ directory:
#   cp .env.example .env
#
# DO NOT commit .env with real credentials to GitHub or public repositories.
# .env is already included in .gitignore.
# ==============================================================================

# AWS Region (CloudShield primary DR region: Asia Pacific - Mumbai)
AWS_REGION=ap-south-1

# Amazon S3 Vault Bucket Name (communicated by Teammate 1 after CloudShell run)
S3_BUCKET_NAME=cloudshield-s3-vault-mumbai

# AWS IAM Credentials for dedicated user (cloudshield-backend-user)
# Generated securely via deployment/cloudshield_aws_setup.sh
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

