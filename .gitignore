# ==========================================
# CloudShield Full-Stack .gitignore
# ==========================================

# --- Node.js & React Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.local

# --- Python & Flask Backend ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# --- Environment Secrets & Credentials ---
.env
*.env
*.pem
*.key
*credentials*.txt

# --- Local S3 Vault Testing Directory ---
backend/local_vault/*
!backend/local_vault/.gitkeep

# --- IDEs & System Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
tempCodeRunnerFile.py
