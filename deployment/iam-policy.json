{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudShieldBucketLevelAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::cloudshield-s3-vault-mumbai"
    },
    {
      "Sid": "CloudShieldObjectLevelAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::cloudshield-s3-vault-mumbai/*"
    }
  ]
}

